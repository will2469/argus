#!/usr/bin/env bash
# Standard Golang Pre-Commit Hook for Argus
# Enforces gofmt, go vet, golint (golangci-lint), and gosec
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
cd "${REPO_DIR}"

export GOWORK="${GOWORK:-off}"
export PATH="${HOME}/go/bin:${HOME}/.local/bin:${PATH}"

# Optional local formatting & AI artifact cleanup (ignored in git)
if [ -x "${SCRIPT_DIR}/format-all.sh" ]; then
    echo "[Argus Hook] Running local format-all..."
    "${SCRIPT_DIR}/format-all.sh"
fi

echo "[Argus Hook] 1/6 Checking Go code formatting with gofmt..."
UNFORMATTED=$(find . -name "*.go" -not -path "./vendor/*" -exec gofmt -l {} +)
if [ -n "${UNFORMATTED}" ]; then
    echo "Error: Unformatted Go files found:"
    echo "${UNFORMATTED}"
    echo "Run: gofmt -w ${UNFORMATTED}"
    exit 1
fi

echo "[Argus Hook] 2/6 Running go vet ./..."
go vet ./...

if command -v golangci-lint >/dev/null 2>&1; then
    echo "[Argus Hook] 3/6 Running golangci-lint (golint)..."
    golangci-lint run --timeout=3m ./... || {
        echo "Warning: golangci-lint reported issues."
    }
else
    echo "[Argus Hook] 3/6 Skipping golangci-lint (not installed in PATH)"
fi

if command -v gosec >/dev/null 2>&1; then
    echo "[Argus Hook] 4/6 Running gosec AST security audit..."
    gosec -quiet -exclude=G101,G104 ./... || {
        echo "Warning: gosec reported potential security findings."
    }
else
    echo "[Argus Hook] 4/6 Skipping gosec (not installed in PATH)"
fi

if command -v govulncheck >/dev/null 2>&1; then
    echo "[Argus Hook] 5/6 Running govulncheck dependency vulnerability audit..."
    govulncheck ./... || {
        echo "Error: govulncheck detected known vulnerabilities in dependencies."
        exit 1
    }
else
    echo "[Argus Hook] 5/6 Skipping govulncheck (not installed in PATH)"
fi

if command -v uvx >/dev/null 2>&1; then
    echo "[Argus Hook] 6/6 Running semgrep audit with uvx..."
    uvx semgrep . --error || {
        echo "Error: semgrep reported security or code hygiene findings. Run 'make semgrep' to inspect."
        exit 1
    }
elif command -v semgrep >/dev/null 2>&1; then
    echo "[Argus Hook] 6/6 Running semgrep audit..."
    semgrep . --error || {
        echo "Error: semgrep reported security or code hygiene findings. Run 'make semgrep' to inspect."
        exit 1
    }
else
    echo "[Argus Hook] 6/6 Skipping semgrep (neither uvx nor semgrep found in PATH)"
fi

echo "[Argus Hook] All standard Go pre-commit checks passed!"
