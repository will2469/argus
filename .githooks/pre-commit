#!/usr/bin/env bash
# Standard Golang Pre-Commit Hook for Argus
# Enforces gofmt, go vet, golint (golangci-lint), and gosec
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
cd "${REPO_DIR}"

export GOWORK="${GOWORK:-off}"

# Optional local formatting & AI artifact cleanup (ignored in git)
if [ -x "${SCRIPT_DIR}/format-all.sh" ]; then
    echo "[Argus Hook] Running local format-all..."
    "${SCRIPT_DIR}/format-all.sh"
fi

echo "[Argus Hook] 1/4 Checking Go code formatting with gofmt..."
UNFORMATTED=$(gofmt -l $(find . -name "*.go" -not -path "./vendor/*" -not -path "*/testdata/*") || true)
if [ -n "${UNFORMATTED}" ]; then
    echo "Error: Unformatted Go files found:"
    echo "${UNFORMATTED}"
    echo "Run: gofmt -w ${UNFORMATTED}"
    exit 1
fi

echo "[Argus Hook] 2/4 Running go vet ./..."
go vet ./...

if command -v golangci-lint >/dev/null 2>&1; then
    echo "[Argus Hook] 3/4 Running golangci-lint (golint)..."
    golangci-lint run --timeout=3m ./... || {
        echo "Warning: golangci-lint reported issues."
    }
else
    echo "[Argus Hook] 3/4 Skipping golangci-lint (not installed in PATH)"
fi

if command -v gosec >/dev/null 2>&1; then
    echo "[Argus Hook] 4/4 Running gosec AST security audit..."
    gosec -quiet -exclude-dir=testdata -exclude=G101,G104 ./... || {
        echo "Warning: gosec reported potential security findings."
    }
else
    echo "[Argus Hook] 4/4 Skipping gosec (not installed in PATH)"
fi

echo "[Argus Hook] All standard Go pre-commit checks passed!"
