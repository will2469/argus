package {{PKG_NAME}}

import (
	"os"
	"path/filepath"
	"sort"
	"strings"

	"github.com/will2469/argus/shared/directives"
	"github.com/will2469/argus/shared/migration"
	"github.com/will2469/argus/shared/sqlparser"
)

// ScanMigrationDir recursively scans all migration files in a directory and its subdirectories.
// MANDATORY INVARIANT: Always use filepath.Walk (never shallow os.ReadDir) to ensure
// multi-service and modular monorepo subfolders are never silently skipped.
func ScanMigrationDir(dir string, dm *directives.DirectiveMap) []migration.Issue {
	var issues []migration.Issue

	// 1. Group files by subdirectory to support modular / multi-service monorepos
	dirFiles := make(map[string]map[string]string)
	_ = filepath.Walk(dir, func(path string, info os.FileInfo, err error) error {
		if err != nil || info == nil || info.IsDir() {
			return nil
		}
		if !strings.HasSuffix(info.Name(), ".up.sql") {
			return nil
		}
		data, err := os.ReadFile(path)
		if err != nil {
			return nil
		}

		subDir := filepath.Dir(path)
		if dirFiles[subDir] == nil {
			dirFiles[subDir] = make(map[string]string)
		}
		content := string(data)
		dirFiles[subDir][path] = content

		// Register directives for both full path and base filename
		if dm != nil {
			fileDm := directives.ParseSQLDirectives(content, path)
			lineCount := strings.Count(content, "\n") + 1
			for l := 1; l <= lineCount; l++ {
				if fileDm.IsLineIgnored(path, l, RuleCode) {
					dm.AddDirective(path, l, RuleCode, "sql directive")
					dm.AddDirective(info.Name(), l, RuleCode, "sql directive")
				}
			}
		}
		return nil
	})

	// 2. Deterministic execution order across subdirectories
	var dirs []string
	for d := range dirFiles {
		dirs = append(dirs, d)
	}
	sort.Strings(dirs)

	for _, d := range dirs {
		files := dirFiles[d]
		var filepaths []string
		for p := range files {
			filepaths = append(filepaths, p)
		}
		sort.Strings(filepaths)

		for _, p := range filepaths {
			content := files[p]
			tree, err := sqlparser.Parse(content)
			if err != nil {
				continue
			}
			fileIssues := InspectSQLStatements(p, content, tree, dm)
			issues = append(issues, fileIssues...)
		}
	}

	return issues
}
